+def _torch_sigmoid_focal_loss(inputs, targets, alpha=0.25, gamma=2):
+    """Reference (unfused) sigmoid focal loss, elementwise; matches the Triton kernel's definition (fp32 maths)."""
+    inputs, targets = inputs.float(), targets.float()
+    prob = inputs.sigmoid()
+    ce_loss = F.binary_cross_entropy_with_logits(inputs, targets, reduction="none")
+    p_t = prob * targets + (1 - prob) * (1 - targets)
+    loss = ce_loss * ((1 - p_t) ** gamma)
+    if alpha >= 0:
+        alpha_t = alpha * targets + (1 - alpha) * (1 - targets)
+        loss = alpha_t * loss
+    return loss
+
+
+def _torch_sigmoid_focal_loss_reduce(inputs, targets, alpha=0.25, gamma=2):
+    return _torch_sigmoid_focal_loss(inputs, targets, alpha, gamma).sum()
+
+
+triton_sigmoid_focal_loss = SigmoidFocalLoss.apply if TRITON_AVAILABLE else _torch_sigmoid_focal_loss
 
 
